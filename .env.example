# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================

# ========================================
# REQUIRED: PINECONE (Vector Database)
# ========================================
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=rag-system

# ========================================
# REQUIRED: OPENAI (LLM)
# ========================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# ========================================
# PRODUCTION: CORS & Frontend
# ========================================
# Set to your actual Vercel frontend URL in production
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# ========================================
# OPTIONAL: Advanced Configuration
# ========================================
LOG_LEVEL=INFO
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_CONTEXT_TOKENS=2000
RETRIEVAL_TOP_K=5
DATA_DIR=data

# Python runtime settings
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# ========================================
# SAH-RAG FEATURE FLAGS
# ========================================
# Every stage is independently switchable. All defaults below reproduce the
# original baseline path; enable only the experiment you want to run.
SAH_ENABLED=true
SAH_STRUCTURE_ENABLED=true
SAH_STRUCTURAL_RETRIEVAL=false
SAH_ADAPTIVE_CONTROLLER=false
SAH_RERANK=false
SAH_EVIDENCE_EXPANSION=false
SAH_EVIDENCE_VALIDATION=false
SAH_GROUNDED_GENERATION=false
SAH_CITATION_VERIFICATION=false
SAH_ABSTAIN_ON_INSUFFICIENT=true
SAH_RETRY_MODE=structure
SAH_MAX_RETRIES=2
SAH_TOP_K=5
SAH_STRUCTURAL_TOP_N=3
SAH_CONTEXT_TOKEN_BUDGET=1800
SAH_RELEVANCE_THRESHOLD=-2.0
SAH_CITATION_THRESHOLD=0.0
SAH_CITATION_VERIFIER=cross-encoder
SAH_CITATION_NLI_MODEL=cross-encoder/nli-deberta-v3-small
SAH_CITATION_NLI_THRESHOLD=0.5

# Local generation / section selection model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=120

